                   'attrs'  => 'fetch · populate · remote-validate'],
    'cotacao'  => ['titulo' => 'Cotação guiada',
                   'resumo' => 'Fila de preenchimento, campo travado sob condição e escolha revertida na hora.',
                   'attrs'  => 'sequence · lock · revert · computed(age)'],
    'wizard'   => ['titulo' => 'Cadastro em etapas',
