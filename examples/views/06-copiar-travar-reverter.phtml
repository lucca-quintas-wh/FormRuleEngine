  <div class="table-scroll">
    <table>
      <tr><th>Chave</th><th>Padrão</th><th>Descrição</th></tr>
      <tr><td><code>source</code></td><td>—</td><td><strong>Obrigatória.</strong> Nome do campo de origem.</td></tr>
