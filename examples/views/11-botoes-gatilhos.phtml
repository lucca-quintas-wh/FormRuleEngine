<?php fre_pagina_fim(['form_estado' => 'formGatilhos', 'script' => <<<'JS'
<script>
document.addEventListener('DOMContentLoaded', function () {
  var contador = document.getElementById('contadorGatilhos');
  var n = 0;
  ['Municipio', 'Bairro'].forEach(function (nome) {
    var campo = document.querySelector('form[name="formGatilhos"] [name="' + nome + '"]');
    if (!campo) return;
    // Escutamos pelo jQuery, não por addEventListener: o plugin dispara com
    // $.trigger(), que percorre só o barramento do jQuery. É a mesma assimetria
    // que faz o núcleo manter uma ponte separada para esse barramento.
    window.$(campo).on('change', function () {
      n++;
      contador.textContent = n + ' evento(s) recebido(s); o último em ' + nome;
      Demo.log('trigger_when → change em ' + nome);
    });
  });
});
</script>
JS
