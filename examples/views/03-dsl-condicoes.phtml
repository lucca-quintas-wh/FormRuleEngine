<script>
(function () {
  var engines = {};
  document.addEventListener('form-rule-engine:ready', function (e) {
    engines[e.target.getAttribute('name')] = e.detail.engine;
  }, true);

  document.addEventListener('DOMContentLoaded', function () {
    /* alternador do parâmetro de formulário */
    var btn = document.getElementById('btnTrocaParam');
    if (btn) btn.addEventListener('click', function () {
      var campo = document.querySelector('[name="__form_param_origem"]');
      campo.value = campo.value === 'interno' ? 'externo' : 'interno';
      // Hidden não emite change sozinho. O núcleo reconhece o prefixo
      // __form_param_ e reavalia TODAS as regras do formulário.
      campo.dispatchEvent(new Event('change', { bubbles: true }));
      Demo.log('__form_param_origem = "' + campo.value + '" → evaluateAll()');
    });

    /* laboratório */
    var ta = document.getElementById('lab');
    var saida = document.getElementById('labResultado');
    var formLab = document.querySelector('form[name="formLab"]');
    if (!ta) return;

    function avaliar() {
      var engine = engines['formLab'];
      if (!engine) { saida.textContent = 'engine ainda não pronta…'; return; }
      var texto = ta.value.trim();
      if (!texto) { saida.textContent = ''; return; }
      var regra;
      try { regra = JSON.parse(texto); }
      catch (err) {
        saida.innerHTML = '<span style="color:var(--warn)">JSON inválido: ' +
                          Demo.escapeHtml(err.message) + '</span>';
        return;
      }
      var r;
      try { r = engine.evaluateCondition(regra); }
      catch (err) {
        saida.innerHTML = '<span style="color:var(--err)">erro: ' +
                          Demo.escapeHtml(err.message) + '</span>';
        return;
      }
      saida.innerHTML = 'evaluateCondition(…) → <strong style="color:' +
        (r ? 'var(--ok)' : 'var(--err)') + '">' + r + '</strong>';
    }

    ta.addEventListener('input', avaliar);
    formLab.addEventListener('input', avaliar);
    formLab.addEventListener('change', avaliar);

    [['igualdade', '{"Status":"A"}'],
     ['pertence a (3)', '{"Status":["A","P","X"]}'],
     ['operador !=', '{"Status":{"!=":"I"}}'],
     ['numérico', '{"Idade":{">=":18}}'],
     ['string vs número', '{"Idade":20}'],
     ['regex', '{"Email":{"regex":"@empresa\\\\.com$"}}'],
     ['entre campos', '{"Confirmacao":{"eq_field":"Senha"}}'],
     ['checkbox', '{"Aceite":"S"}'],
     ['OR aninhado', '{"OR":[{"Status":"I"},{"AND":[{"Status":"P"},{"Idade":{"<":18}}]}]}'],
     ['⚠ 2ª chave ignorada', '{"Status":"I","Idade":{">":99}}']
    ].forEach(function (par) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'secondary small';
      b.textContent = par[0];
      b.addEventListener('click', function () { ta.value = par[1]; avaliar(); });
      document.getElementById('labExemplos').appendChild(b);
    });

    setTimeout(avaliar, 0);
  });
})();
</script>
JS
