<script>
(function() {
    // Filtra as options do select pelo texto digitado
    function filterSelect(input) {
        var wrap = input.closest('.ilu-select-busca');
        if (!wrap) return;
        var sel = wrap.querySelector('select.ilu-select-busca__select');
        if (!sel) return;
        var q = (input.value || '').toLowerCase();
        var opts = sel.options;
        for (var i = 0; i < opts.length; i++) {
            var hide = q.length > 0 && opts[i].text.toLowerCase().indexOf(q) < 0;
            opts[i].hidden = hide;
            opts[i].style.display = hide ? 'none' : '';
        }
    }

    // Vincula direto no input de busca (idempotente por elemento)
    function initSB(input) {
        if (!input || input.dataset.sbBound === '1') return;
        input.dataset.sbBound = '1';
        input.addEventListener('input', function() { filterSelect(input); });
        input.addEventListener('click', function() { input.select(); });
    }

    // Em multi-select: clicar alterna a seleção sem precisar de Ctrl/Cmd
    function initToggle(sel) {
        if (!sel || sel.dataset.sbToggle === '1' || !sel.multiple) return;
        sel.dataset.sbToggle = '1';
        sel.addEventListener('mousedown', function(e) {
            var opt = e.target;
            if (!opt || opt.tagName !== 'OPTION') return;
            e.preventDefault();
            opt.selected = !opt.selected;
            sel.focus();
            sel.dispatchEvent(new Event('change', { bubbles: true }));
        });
    }

    function initAll(root) {
        var scope = root || document;
        var inputs = scope.querySelectorAll('.ilu-select-busca__search');
        for (var i = 0; i < inputs.length; i++) initSB(inputs[i]);
        var selects = scope.querySelectorAll('select.ilu-select-busca__select');
        for (var j = 0; j < selects.length; j++) initToggle(selects[j]);
    }

    // Carga inicial (drawer/form já presentes neste render)
    initAll(document);

    // Novas linhas do repeater
    if (!window.__iluSBrepeaterHook) {
        window.__iluSBrepeaterHook = 1;
        document.addEventListener('ilu:repeater:row-added', function(e) {
            var row = e.detail && e.detail.row ? e.detail.row : document;
            initAll(row);
        });
    }
})();
</script>
