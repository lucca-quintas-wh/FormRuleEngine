if (!function_exists('fbCompactRenderJsArg')) {
function fbCompactRenderJsArg($value) {
    if ($value === null) return "''";
    if (is_bool($value)) return $value ? 'true' : 'false';
    if (is_numeric($value)) return (string) $value;
    return "'" . addslashes((string) $value) . "'";
}
}

if (!function_exists('fbCompactDefaultMode')) {
function fbCompactDefaultMode($type, $isAggregate = false) {
    $dialogMode = defined('DIALOG') && DIALOG != false;
    switch ($type) {
        case 'save': case 'btn1':
            return $isAggregate ? ($dialogMode ? 7 : 5) : ($dialogMode ? 1 : 2);
        case 'save_and_add': case 'btn2':
            return $dialogMode ? ($isAggregate ? 8 : 3) : 4;
        default: return 2;
    }
}
}

if (!function_exists('fbCompactBuildBackRoute')) {
function fbCompactBuildBackRoute($action, $controllerName) {
    if ($action === '') return $controllerName !== '' ? $controllerName . '/listagem' : '';
    if ($controllerName !== '' && strpos($action, '/') === false) return $controllerName . '/' . $action;
    return $action;
}
}

if (!function_exists('fbCompactConditionMet')) {
function fbCompactConditionMet($condition) {
    if ($condition === null || $condition === '') return true;
    if (is_bool($condition)) return $condition;
    $condition = trim((string) $condition);
    if ($condition === '!DIALOG') return !defined('DIALOG') || DIALOG == false;
    if ($condition === 'DIALOG') return defined('DIALOG') && DIALOG != false;
    return $condition !== '';
}
}

if (!function_exists('fbRepeaterRenderTemplateField')) {
function fbRepeaterRenderTemplateField(array $fieldCfg): string {
    $cfg      = $fieldCfg;
    $origName = (string) ($fieldCfg['name'] ?? '');
    $cfg['name'] = $origName . '__IDX__';
    if (isset($cfg['id'])) $cfg['id'] = (string) $cfg['id'] . '__IDX__';
    // Não pré-preenche valores no template
    unset($cfg['value'], $cfg['display']);

    $fieldObj  = FormFieldFactory::make($cfg);
    $fieldHtml = $fieldObj->compilate();
    if (method_exists($fieldObj, 'getLoader')) {
        $fieldHtml .= $fieldObj->getLoader();
    }

    $label    = $fieldCfg['label'] ?? '';
    $required = !empty($fieldCfg['required']);
    $col      = max(1, min(12, (int) ($fieldCfg['col'] ?? 6)));
    $fieldId  = $cfg['name'];

    $labelHtml = '';
    if ($label !== '') {
        $reqClass  = $required ? ' ilu-form-compact__label--required' : '';
        $labelHtml = '<label class="ilu-form-compact__label' . $reqClass . '" for="'
                   . htmlspecialchars($fieldId, ENT_QUOTES, 'UTF-8') . '">'
                   . htmlspecialchars($label, ENT_QUOTES, 'UTF-8') . '</label>';
    }

    $ruleAttrMap = [
        'fetch_when'     => 'fetch',
        'visible_when'   => 'visible',
        'required_when'  => 'required',
        'disabled_when'  => 'disabled',
        'set_value_when' => 'set-value',
        'computed_when'  => 'computed',
        'trigger_when'   => 'trigger',
        'populate_when'  => 'populate',
        'lock_when'      => 'lock',
    ];
    $ruleAttrs = '';
    foreach ($ruleAttrMap as $cfgKey => $attrName) {
        if (!empty($fieldCfg[$cfgKey])) {
            $ruleAttrs .= ' data-' . $attrName . '-when="'
                . htmlspecialchars(json_encode($fieldCfg[$cfgKey]), ENT_QUOTES, 'UTF-8') . '"';
        }
    }

    // wrapper_id (com __IDX__ preservado) — permite que fetch/set_html mirem o wrapper
    // por linha, ex.: ícone %/R$ do campo money via '#aplComissao__IDX__ .input-group-text'.
    $wrapperId     = isset($fieldCfg['wrapper_id']) ? (string) $fieldCfg['wrapper_id'] : '';
    $wrapperIdAttr = $wrapperId !== '' ? ' id="' . htmlspecialchars($wrapperId, ENT_QUOTES, 'UTF-8') . '"' : '';

    return '<div class="ilu-form-compact__field ilu-form-compact__field--col-' . $col . '"' . $wrapperIdAttr . $ruleAttrs . '>'
         . $labelHtml
         . '<div class="ilu-form-compact__input">' . $fieldHtml . '</div>'
         . '</div>';
}
}

if (!function_exists('fbCompactRenderButton')) {
function fbCompactRenderButton($buttonKey, $button, $formName = '', $controllerName = '', $defaultAfterAction = 'listagem', $isAggregate = false) {
    if (empty($button) || $button === false) return '';
    if ($button === true) $button = ['type' => $buttonKey];
    if (is_object($button) && method_exists($button, 'compilate')) return $button->compilate();
    if (is_string($button)) return $button;
    if (!is_array($button)) return '';
    if (!fbCompactConditionMet($button['condition'] ?? null)) return '';

    $type = $button['type'] ?? ($button['name'] ?? $buttonKey);
    $label = $button['label'] ?? ($button['value'] ?? '');
    $action = $button['action'] ?? '';
    $onclick = $button['onclick'] ?? ($button['onClick'] ?? '');
    $returnMode = $button['return_mode'] ?? ($button['mode'] ?? fbCompactDefaultMode($type, $isAggregate));
    $extraParam = $button['extra_param'] ?? ($button['extraParam'] ?? '');
    $extraParam2 = $button['extra_param_2'] ?? ($button['extraParam2'] ?? '');
    $afterActionBtn = $button['after_action'] ?? ($button['afterAction'] ?? ($button['afteract'] ?? $defaultAfterAction));
    $class = $button['class'] ?? 'btn-v5-primary';

    if (empty($label)) {
        switch ($type) {
            case 'save': case 'btn1': $label = 'Salvar'; break;
            case 'save_and_add': case 'btn2': $label = 'Salvar e Adicionar'; break;
            case 'back': case 'btn3': $label = 'Voltar'; break;
            default: $label = 'Botão';
        }
    }

    if (empty($onclick)) {
        if (strpos($action, '(') !== false) {
            $onclick = $action;
        } elseif (in_array($type, ['back', 'btn3'], true)) {
            $backRoute = fbCompactBuildBackRoute($action, $controllerName);
            if ($backRoute !== '') {
                $onclick = "voltar(" . fbCompactRenderJsArg($backRoute) . ", " . fbCompactRenderJsArg($formName) . ")";
            }
        } elseif (!empty($action) && !empty($formName) && !empty($controllerName)) {
            $args = [
                fbCompactRenderJsArg($formName),
                fbCompactRenderJsArg($controllerName),
                fbCompactRenderJsArg($action),
                fbCompactRenderJsArg($afterActionBtn),
                fbCompactRenderJsArg($returnMode),
            ];
            if ($extraParam !== '') $args[] = fbCompactRenderJsArg($extraParam);
            if ($extraParam2 !== '') {
                if ($extraParam === '') $args[] = "''";
                $args[] = fbCompactRenderJsArg($extraParam2);
            }
            $onclick = 'sendForm(' . implode(', ', $args) . ')';
        } elseif (!empty($action)) {
            $onclick = "voltar(" . fbCompactRenderJsArg($action) . ", " . fbCompactRenderJsArg($formName) . ")";
        }
    }

    $icon = $button['icon'] ?? '';
    $iconHtml = '';
    if ($icon !== '') {
        $iconHtml = '<svg class="ilu-form-btn-icon" width="16" height="16"><use href="#' . htmlspecialchars($icon) . '"></use></svg>';
    }

    $attrs = '';
    if (!empty($button['__confirm_submit_json'])) {
        $attrs .= ' data-confirm-submit-when="' . htmlspecialchars($button['__confirm_submit_json']) . '"';
    }

    return '<button type="button" class="' . htmlspecialchars($class) . '" onclick="' . IluAtributo::js($onclick) . '"' . $attrs . '>' . $iconHtml . htmlspecialchars($label) . '</button>';
}
}
