<?php if (strpos($afterScript, '<script') === false): ?>
<script>
<?=$afterScript;?>
</script>
<?php else: ?>
<?=$afterScript;?>
<?php endif; ?>
<?php endif; ?>

<?php
// Inclui o JS de visibilidade condicional se houver regras declarativas
$hasVisibility = $clientBehaviorsJson !== '';
foreach ($sections as $sec) {
    if (!empty($sec['__visible_when_json'])) {
        $hasVisibility = true;
        break;
    }
    if (!empty($sec['fields'])) {
        foreach ($sec['fields'] as $fld) {
            if (!is_array($fld)) continue;
            if (!empty($fld['__visible_when_json']) ||
                !empty($fld['__required_when_json']) ||
                !empty($fld['__disabled_when_json']) ||
                !empty($fld['__label_when_json']) ||
                !empty($fld['__options_when_json']) ||
                !empty($fld['__mask_when_json']) ||
                !empty($fld['__validate_when_json']) ||
                !empty($fld['__fetch_when_json']) ||
                !empty($fld['__remote_validate_when_json']) ||
                !empty($fld['__set_value_when_json']) ||
                !empty($fld['__computed_when_json']) ||
                !empty($fld['__lock_when_json']) ||
                !empty($fld['__prevent_submit_when_json']) ||
                !empty($fld['__populate_when_json']) ||
                !empty($fld['__dynamic_table_json'])) {
                $hasVisibility = true;
                break 2;
            }
        }
    }
}
foreach ($buttons as $btn) {
    if (is_array($btn) && !empty($btn['__confirm_submit_json'])) {
        $hasVisibility = true;
        break;
    }
}

if (!$hasVisibility && !empty($afterHtml) && strpos($afterHtml, 'data-visible-when') !== false) {
    $hasVisibility = true;
}

// Detecta plugins ativos para v2.0
$activePlugins = [];
if ($hasVisibility) {
    if ($clientBehaviorsJson !== '') $activePlugins[] = 'behavior';
    foreach ($sections as $sec) {
        foreach ($sec['fields'] as $fld) {
            if (!is_array($fld)) continue;
            if (!empty($fld['__options_when_json'])) $activePlugins[] = 'options';
            if (!empty($fld['__mask_when_json'])) $activePlugins[] = 'mask';
            if (!empty($fld['__validate_when_json'])) $activePlugins[] = 'validate';
            if (!empty($fld['__fetch_when_json'])) $activePlugins[] = 'fetch';
            if (!empty($fld['__remote_validate_when_json'])) $activePlugins[] = 'remote-validate';
            if (!empty($fld['__set_value_when_json'])) $activePlugins[] = 'set-value';
            if (!empty($fld['__computed_when_json'])) $activePlugins[] = 'computed';
            if (!empty($fld['__lock_when_json'])) $activePlugins[] = 'lock';
            if (!empty($fld['__prevent_submit_when_json'])) $activePlugins[] = 'prevent-submit';
            if (!empty($fld['__populate_when_json'])) $activePlugins[] = 'populate';
            if (!empty($fld['__copy_when_json'])) $activePlugins[] = 'copy';
            if (!empty($fld['__revert_when_json'])) $activePlugins[] = 'revert';
            if (!empty($fld['__dynamic_table_json'])) $activePlugins[] = 'dynamic-table';
        }
    }
    foreach ($buttons as $btn) {
        if (is_array($btn) && !empty($btn['__confirm_submit_json'])) $activePlugins[] = 'confirm-submit';
    }
    if (!empty($__submit_handler_json)) $activePlugins[] = 'submit-handler';
    // Gating sequencial (form-rule-sequence). Varredura RECURSIVA porque a config
    // aninha campos em cards/grupos e o laco acima le um nivel so. Nao da para
    // registrar incondicionalmente: $activePlugins vazio e o que faz o form cair
    // no form-visibility.js legado, e forcar o ramo v2 recarrega engine+plugins
    // por cima dos ja carregados pela pagina -> "redeclaration of let FormRule*".
    $iluTemSequence = function ($nos) use (&$iluTemSequence) {
        foreach ((array) $nos as $no) {
            if (!is_array($no)) { continue; }
            if (!empty($no['properties']['data-sequence'])) { return true; }
            foreach (['fields', 'sections', 'children', 'components'] as $k) {
                if (!empty($no[$k]) && $iluTemSequence($no[$k])) { return true; }
            }
        }
        return false;
    };
    if ($iluTemSequence($sections)) { $activePlugins[] = 'sequence'; }
    $activePlugins = array_unique($activePlugins);
}
?>
<?php if ($hasVisibility && $loadRuleAssets): ?>
    <?php if (!empty($activePlugins)): ?>
        <!-- FormRuleEngine v2.0 -->
        <script src="<?=SYSPATH;?>layout/js/form-rule-engine.js?v=2.26"></script>
        <script src="<?=SYSPATH;?>layout/js/plugins/form-rule-base.js?v=2.26"></script>
        <script src="<?=SYSPATH;?>layout/js/plugins/form-rule-visible.js?v=2.26"></script>
        <script src="<?=SYSPATH;?>layout/js/plugins/form-rule-required.js?v=2.26"></script>
        <script src="<?=SYSPATH;?>layout/js/plugins/form-rule-disabled.js?v=2.26"></script>
        <script src="<?=SYSPATH;?>layout/js/plugins/form-rule-label.js?v=2.26"></script>
        <?php foreach ($activePlugins as $plugin): ?>
            <script src="<?=SYSPATH;?>layout/js/plugins/form-rule-<?=$plugin;?>.js?v=2.26"></script>
        <?php endforeach; ?>
        <script src="<?=SYSPATH;?>layout/js/form-visibility-v2.js?v=2.26"></script>
    <?php else: ?>
        <!-- FormVisibilityManager v1.1 (legacy) -->
        <script src="<?=SYSPATH;?>layout/js/form-visibility.js?v=1.4"></script>
    <?php endif; ?>
<?php endif; ?>
