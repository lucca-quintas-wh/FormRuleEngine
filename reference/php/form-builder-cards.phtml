    foreach ($sec['fields'] ?? [] as $field) {
        if (is_object($field) && method_exists($field, 'getName')) {
            $fieldsByName[$field->getName()] = $field;
        } elseif (is_array($field) && !empty($field['name'])) {
            $fieldsByName[$field['name']] = $field;
        }
    }
}

if (!function_exists('fbCardField')) {
function fbCardField($name, $map) {
    $field = $map[$name] ?? null;
    if ($field === null) return '';
    if (is_object($field) && method_exists($field, 'compilate')) {
        return $field->compilate();
    }
    if (is_array($field) && !empty($field['tag']) && is_object($field['tag']) && method_exists($field['tag'], 'compilate')) {
        return $field['tag']->compilate();
    }
    if (is_array($field) && !empty($field['field']) && is_object($field['field']) && method_exists($field['field'], 'compilate')) {
        return $field['field']->compilate();
    }
    if (is_array($field) && !empty($field['input'])) {
        return is_object($field['input']) && method_exists($field['input'], 'compilate')
            ? $field['input']->compilate()
            : (string) $field['input'];
    }
    if (is_array($field) && !empty($field['html'])) {
        return (string) $field['html'];
    }
    return '';
}
}

if (!function_exists('fbCardFieldObj')) {
function fbCardFieldObj($name, $map) {
    $field = $map[$name] ?? null;
    if ($field === null) return null;
    if (is_object($field) && method_exists($field, 'compilate')) {
        return $field;
    }
    if (is_array($field) && !empty($field['tag']) && is_object($field['tag']) && method_exists($field['tag'], 'compilate')) {
        return $field['tag'];
    }
    if (is_array($field) && !empty($field['field']) && is_object($field['field']) && method_exists($field['field'], 'compilate')) {
        return $field['field'];
    }
    if (is_array($field) && !empty($field['input']) && is_object($field['input']) && method_exists($field['input'], 'compilate')) {
        return $field['input'];
    }
    return null;
}
}

if (!function_exists('fbCardCaptureLupa')) {
function fbCardCaptureLupa($fieldObj) {
    if (!is_object($fieldObj) || !method_exists($fieldObj, 'getLupa')) {
        return '';
    }

    ob_start();
    $result = $fieldObj->getLupa();
    $buffer = ob_get_clean();

    if (is_string($result) && $result !== '') {
        return $result;
    }

    return $buffer;
}
}

if (!function_exists('fbCardFieldLabel')) {
function fbCardFieldLabel($name, $map) {
    $field = $map[$name] ?? null;
    if ($field === null) return '';
    if (is_object($field) && method_exists($field, 'getLabel')) {
        return $field->getLabel();
    }
    if (is_array($field) && !empty($field['label'])) {
        return $field['label'];
    }
    if (is_array($field) && !empty($field['tag']) && is_object($field['tag']) && method_exists($field['tag'], 'getLabel')) {
        return $field['tag']->getLabel();
    }
    if (is_array($field) && !empty($field['field']) && is_object($field['field']) && method_exists($field['field'], 'getLabel')) {
        return $field['field']->getLabel();
    }
    if (is_array($field) && !empty($field['input']) && is_object($field['input']) && method_exists($field['input'], 'getLabel')) {
        return $field['input']->getLabel();
    }
    return '';
}
}

if (!function_exists('fbCardFieldHasRequired')) {
function fbCardFieldHasRequired($name, $map) {
    $field = $map[$name] ?? null;
    if ($field === null) return false;
    if (is_array($field) && !empty($field['required'])) {
        return true;
    }
    $label = fbCardFieldLabel($name, $map);
    if ($label !== '' && strpos($label, 'asterisk') !== false) {
        return true;
    }
    return false;
}
}

// Helpers de botão
if (!function_exists('fbCardRenderJsArg')) {
function fbCardRenderJsArg($value) {
    if ($value === null) return "''";
    if (is_bool($value)) return $value ? 'true' : 'false';
    if (is_numeric($value)) return (string) $value;
    return "'" . addslashes((string) $value) . "'";
}
}

if (!function_exists('fbCardDefaultMode')) {
function fbCardDefaultMode($type, $isAggregate = false) {
    $dialogMode = defined('DIALOG') && DIALOG != false;
    switch ($type) {
        case 'save': case 'btn1':
            return $isAggregate ? ($dialogMode ? 7 : 5) : ($dialogMode ? 1 : 2);
        case 'save_and_add': case 'btn2':
            return $dialogMode ? ($isAggregate ? 8 : 3) : 4;
        default: return 2;
    }
}
}

if (!function_exists('fbCardBuildBackRoute')) {
function fbCardBuildBackRoute($action, $controllerName) {
    if ($action === '') return $controllerName !== '' ? $controllerName . '/listagem' : '';
    if ($controllerName !== '' && strpos($action, '/') === false) return $controllerName . '/' . $action;
    return $action;
}
}

if (!function_exists('fbCardRenderIcon')) {
function fbCardRenderIcon($icon, $basePath = __DIR__ . '/../../../assets/svg') {
    if (empty($icon)) return '';
    // Se já é HTML (svg/img inline), renderiza direto
    if (strpos($icon, '<') !== false) {
        return '<span class="ilu-card__icon">' . $icon . '</span>';
    }
    if (function_exists('getHeroiconSVG')) {
        $svg = getHeroiconSVG($icon, 'ilu-card__icon-svg', 'sm');
        if ($svg !== '') {
            return '<span class="ilu-card__icon">' . $svg . '</span>';
        }
    }
    // Tenta ler SVG do assets/svg/
    $svgPath = $basePath . '/' . $icon . '.svg';
    if (file_exists($svgPath)) {
        $svg = file_get_contents($svgPath);
        if (strpos($svg, '<svg') !== false) {
            $svg = preg_replace('/<svg\\s/i', '<svg class="ilu-card__icon-svg" width="20" height="20" style="width:20px;height:20px;display:inline-block;flex-shrink:0;" ', $svg, 1);
        }
        return '<span class="ilu-card__icon">' . $svg . '</span>';
    }
    return '';
}
}

if (!function_exists('fbCardConditionMet')) {
function fbCardConditionMet($condition) {
    if ($condition === null || $condition === '') return true;
    if (is_bool($condition)) return $condition;
    $condition = trim((string) $condition);
    if ($condition === '!DIALOG') return !defined('DIALOG') || DIALOG == false;
    if ($condition === 'DIALOG') return defined('DIALOG') && DIALOG != false;
    return $condition !== '';
}
}

if (!function_exists('fbCardRenderButton')) {
function fbCardRenderButton($buttonKey, $button, $formName = '', $controllerName = '', $defaultAfterAction = 'listagem', $isAggregate = false) {
    if (empty($button) || $button === false) return '';
    if ($button === true) $button = ['type' => $buttonKey];
    if (is_object($button) && method_exists($button, 'compilate')) return $button->compilate();
    if (is_string($button)) return $button;
    if (!is_array($button)) return '';
    if (!fbCardConditionMet($button['condition'] ?? null)) return '';

    $type = $button['type'] ?? ($button['name'] ?? $buttonKey);
    $label = $button['label'] ?? ($button['value'] ?? '');
    $action = $button['action'] ?? '';
    $onclick = $button['onclick'] ?? ($button['onClick'] ?? '');
    $returnMode = $button['return_mode'] ?? ($button['mode'] ?? fbCardDefaultMode($type, $isAggregate));
    $extraParam = $button['extra_param'] ?? ($button['extraParam'] ?? '');
    $extraParam2 = $button['extra_param_2'] ?? ($button['extraParam2'] ?? '');
    $afterActionBtn = $button['after_action'] ?? ($button['afterAction'] ?? ($button['afteract'] ?? $defaultAfterAction));
    $class = $button['class'] ?? 'btn-v5-primary';

    if (empty($label)) {
        switch ($type) {
            case 'save': case 'btn1': $label = 'Salvar'; break;
            case 'save_and_add': case 'btn2': $label = 'Salvar e Adicionar'; break;
            case 'back': case 'btn3': $label = 'Voltar'; break;
            default: $label = 'Botão';
        }
    }

    if (empty($onclick)) {
        if (strpos($action, '(') !== false) {
            $onclick = $action;
        } elseif (in_array($type, ['back', 'btn3'], true)) {
            $backRoute = fbCardBuildBackRoute($action, $controllerName);
            if ($backRoute !== '') {
                $onclick = "voltar(" . fbCardRenderJsArg($backRoute) . ", " . fbCardRenderJsArg($formName) . ")";
            }
        } elseif (!empty($action) && !empty($formName) && !empty($controllerName)) {
            $args = [
                fbCardRenderJsArg($formName),
                fbCardRenderJsArg($controllerName),
                fbCardRenderJsArg($action),
                fbCardRenderJsArg($afterActionBtn),
                fbCardRenderJsArg($returnMode),
            ];
            if ($extraParam !== '') $args[] = fbCardRenderJsArg($extraParam);
            if ($extraParam2 !== '') {
                if ($extraParam === '') $args[] = "''";
                $args[] = fbCardRenderJsArg($extraParam2);
            }
            $onclick = 'sendForm(' . implode(', ', $args) . ')';
        } elseif (!empty($action)) {
            $onclick = "voltar(" . fbCardRenderJsArg($action) . ", " . fbCardRenderJsArg($formName) . ")";
        }
    }

    $icon = $button['icon'] ?? '';
    $iconHtml = '';
    if ($icon !== '') {
        $iconHtml = '<svg class="ilu-form-btn-icon" width="16" height="16"><use href="#' . htmlspecialchars($icon) . '"></use></svg>';
    }

    $attrs = '';
    if (!empty($button['__confirm_submit_json'])) {
        $attrs .= ' data-confirm-submit-when="' . htmlspecialchars($button['__confirm_submit_json']) . '"';
    }

    return '<button type="button" class="' . htmlspecialchars($class) . '" onclick="' . IluAtributo::js($onclick) . '"' . $attrs . '>' . $iconHtml . htmlspecialchars($label) . '</button>';
}
}
